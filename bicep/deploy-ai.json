{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.44.1.10279",
      "templateHash": "2117107776462251141"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region."
      }
    },
    "resourceNameSeed": {
      "type": "string",
      "metadata": {
        "description": "Deterministic seed used to build resource names across modules."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Common tags."
      }
    },
    "backendPrincipalId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Backend managed identity principal ID. Receives RBAC on AI and Search resources when provided."
      }
    },
    "aiServicesSku": {
      "type": "string",
      "defaultValue": "S0",
      "allowedValues": [
        "S0"
      ],
      "metadata": {
        "description": "Azure AI Services SKU for Foundry/OpenAI model deployments."
      }
    },
    "speechSku": {
      "type": "string",
      "defaultValue": "S0",
      "allowedValues": [
        "F0",
        "S0"
      ],
      "metadata": {
        "description": "Azure AI Speech SKU."
      }
    },
    "chatDeploymentName": {
      "type": "string",
      "defaultValue": "gpt-5-6-sol",
      "metadata": {
        "description": "Chat model deployment name used by the application."
      }
    },
    "chatModelName": {
      "type": "string",
      "defaultValue": "gpt-5.6-sol",
      "metadata": {
        "description": "Chat model name. Override at deploy time if a newer model is available in the target region."
      }
    },
    "chatModelVersion": {
      "type": "string",
      "defaultValue": "2026-07-09",
      "metadata": {
        "description": "Chat model version. Must be available in the selected Azure region."
      }
    },
    "chatDeploymentSku": {
      "type": "string",
      "defaultValue": "DataZoneStandard",
      "allowedValues": [
        "GlobalStandard",
        "DataZoneStandard",
        "Standard"
      ],
      "metadata": {
        "description": "Deployment SKU for the chat model. GPT-5.6 Sol in France Central supports GlobalStandard and DataZoneStandard, not Standard."
      }
    },
    "chatDeploymentCapacity": {
      "type": "int",
      "defaultValue": 10,
      "metadata": {
        "description": "Tokens-per-minute capacity for the chat model deployment."
      }
    },
    "embeddingDeploymentName": {
      "type": "string",
      "defaultValue": "text-embedding-3-large",
      "metadata": {
        "description": "Embedding model deployment name used by ingestion and RAG."
      }
    },
    "embeddingModelName": {
      "type": "string",
      "defaultValue": "text-embedding-3-large",
      "metadata": {
        "description": "Embedding model name."
      }
    },
    "embeddingModelVersion": {
      "type": "string",
      "defaultValue": "1",
      "metadata": {
        "description": "Embedding model version. Must be available in the selected Azure region."
      }
    },
    "embeddingDeploymentCapacity": {
      "type": "int",
      "defaultValue": 10,
      "metadata": {
        "description": "Tokens-per-minute capacity for the embedding model deployment."
      }
    },
    "searchSku": {
      "type": "string",
      "defaultValue": "basic",
      "allowedValues": [
        "free",
        "basic",
        "standard",
        "standard2",
        "standard3"
      ],
      "metadata": {
        "description": "Azure AI Search SKU for the RAG index."
      }
    },
    "searchIndexName": {
      "type": "string",
      "defaultValue": "engineering-docs",
      "metadata": {
        "description": "Default index name expected by the Engineering Copilot ingestion/API layer."
      }
    }
  },
  "variables": {
    "nameSeedSafe": "[toLower(replace(parameters('resourceNameSeed'), '-', ''))]",
    "uniqueSuffix": "[uniqueString(resourceGroup().id)]",
    "aiServicesName": "[toLower(take(format('ai{0}{1}', variables('nameSeedSafe'), variables('uniqueSuffix')), 64))]",
    "speechServiceName": "[toLower(take(format('spch{0}{1}', variables('nameSeedSafe'), variables('uniqueSuffix')), 64))]",
    "searchServiceName": "[toLower(take(format('srch{0}{1}', variables('nameSeedSafe'), variables('uniqueSuffix')), 60))]",
    "hasBackendPrincipal": "[not(empty(parameters('backendPrincipalId')))]",
    "cognitiveServicesOpenAiUserRoleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '5e0bd9bd-7b93-4f28-af87-19fc36ad61bd')]",
    "cognitiveServicesSpeechUserRoleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'f2dc8367-1007-4938-bd23-fe263f013447')]",
    "searchServiceContributorRoleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '7ca78c08-252a-4471-8644-bb5ff32d4ba0')]",
    "searchIndexDataContributorRoleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '8ebe5a00-799e-43f5-93ac-243d3dce84a7')]"
  },
  "resources": [
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2024-10-01",
      "name": "[variables('aiServicesName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "kind": "AIServices",
      "sku": {
        "name": "[parameters('aiServicesSku')]"
      },
      "properties": {
        "customSubDomainName": "[variables('aiServicesName')]",
        "publicNetworkAccess": "Enabled",
        "networkAcls": {
          "defaultAction": "Allow",
          "virtualNetworkRules": [],
          "ipRules": []
        },
        "disableLocalAuth": true
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2024-10-01",
      "name": "[format('{0}/{1}', variables('aiServicesName'), parameters('chatDeploymentName'))]",
      "sku": {
        "name": "[parameters('chatDeploymentSku')]",
        "capacity": "[parameters('chatDeploymentCapacity')]"
      },
      "properties": {
        "model": {
          "format": "OpenAI",
          "name": "[parameters('chatModelName')]",
          "version": "[parameters('chatModelVersion')]"
        },
        "raiPolicyName": "Microsoft.Default"
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('aiServicesName'))]"
      ]
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2024-10-01",
      "name": "[format('{0}/{1}', variables('aiServicesName'), parameters('embeddingDeploymentName'))]",
      "sku": {
        "name": "Standard",
        "capacity": "[parameters('embeddingDeploymentCapacity')]"
      },
      "properties": {
        "model": {
          "format": "OpenAI",
          "name": "[parameters('embeddingModelName')]",
          "version": "[parameters('embeddingModelVersion')]"
        },
        "raiPolicyName": "Microsoft.Default"
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('aiServicesName'))]",
        "[resourceId('Microsoft.CognitiveServices/accounts/deployments', variables('aiServicesName'), parameters('chatDeploymentName'))]"
      ]
    },
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2024-10-01",
      "name": "[variables('speechServiceName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "kind": "SpeechServices",
      "sku": {
        "name": "[parameters('speechSku')]"
      },
      "properties": {
        "customSubDomainName": "[variables('speechServiceName')]",
        "publicNetworkAccess": "Enabled",
        "networkAcls": {
          "defaultAction": "Allow",
          "virtualNetworkRules": [],
          "ipRules": []
        },
        "disableLocalAuth": true
      }
    },
    {
      "type": "Microsoft.Search/searchServices",
      "apiVersion": "2023-11-01",
      "name": "[variables('searchServiceName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "sku": {
        "name": "[parameters('searchSku')]"
      },
      "properties": {
        "replicaCount": 1,
        "partitionCount": 1,
        "hostingMode": "default",
        "publicNetworkAccess": "enabled",
        "disableLocalAuth": false,
        "networkRuleSet": {
          "ipRules": []
        }
      }
    },
    {
      "condition": "[variables('hasBackendPrincipal')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.CognitiveServices/accounts', variables('aiServicesName'))]",
      "name": "[guid(resourceId('Microsoft.CognitiveServices/accounts', variables('aiServicesName')), parameters('backendPrincipalId'), variables('cognitiveServicesOpenAiUserRoleDefinitionId'))]",
      "properties": {
        "roleDefinitionId": "[variables('cognitiveServicesOpenAiUserRoleDefinitionId')]",
        "principalId": "[parameters('backendPrincipalId')]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('aiServicesName'))]"
      ]
    },
    {
      "condition": "[variables('hasBackendPrincipal')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.CognitiveServices/accounts', variables('speechServiceName'))]",
      "name": "[guid(resourceId('Microsoft.CognitiveServices/accounts', variables('speechServiceName')), parameters('backendPrincipalId'), variables('cognitiveServicesSpeechUserRoleDefinitionId'))]",
      "properties": {
        "roleDefinitionId": "[variables('cognitiveServicesSpeechUserRoleDefinitionId')]",
        "principalId": "[parameters('backendPrincipalId')]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('speechServiceName'))]"
      ]
    },
    {
      "condition": "[variables('hasBackendPrincipal')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Search/searchServices', variables('searchServiceName'))]",
      "name": "[guid(resourceId('Microsoft.Search/searchServices', variables('searchServiceName')), parameters('backendPrincipalId'), variables('searchServiceContributorRoleDefinitionId'))]",
      "properties": {
        "roleDefinitionId": "[variables('searchServiceContributorRoleDefinitionId')]",
        "principalId": "[parameters('backendPrincipalId')]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Search/searchServices', variables('searchServiceName'))]"
      ]
    },
    {
      "condition": "[variables('hasBackendPrincipal')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Search/searchServices', variables('searchServiceName'))]",
      "name": "[guid(resourceId('Microsoft.Search/searchServices', variables('searchServiceName')), parameters('backendPrincipalId'), variables('searchIndexDataContributorRoleDefinitionId'))]",
      "properties": {
        "roleDefinitionId": "[variables('searchIndexDataContributorRoleDefinitionId')]",
        "principalId": "[parameters('backendPrincipalId')]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Search/searchServices', variables('searchServiceName'))]"
      ]
    }
  ],
  "outputs": {
    "aiServicesName": {
      "type": "string",
      "value": "[variables('aiServicesName')]"
    },
    "aiServicesEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', variables('aiServicesName')), '2024-10-01').endpoint]"
    },
    "aiServicesId": {
      "type": "string",
      "value": "[resourceId('Microsoft.CognitiveServices/accounts', variables('aiServicesName'))]"
    },
    "chatDeploymentName": {
      "type": "string",
      "value": "[parameters('chatDeploymentName')]"
    },
    "embeddingDeploymentName": {
      "type": "string",
      "value": "[parameters('embeddingDeploymentName')]"
    },
    "speechServiceName": {
      "type": "string",
      "value": "[variables('speechServiceName')]"
    },
    "speechEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', variables('speechServiceName')), '2024-10-01').endpoint]"
    },
    "speechServiceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.CognitiveServices/accounts', variables('speechServiceName'))]"
    },
    "speechRegion": {
      "type": "string",
      "value": "[parameters('location')]"
    },
    "searchServiceName": {
      "type": "string",
      "value": "[variables('searchServiceName')]"
    },
    "searchEndpoint": {
      "type": "string",
      "value": "[format('https://{0}.search.windows.net', variables('searchServiceName'))]"
    },
    "searchServiceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Search/searchServices', variables('searchServiceName'))]"
    },
    "searchIndexName": {
      "type": "string",
      "value": "[parameters('searchIndexName')]"
    },
    "backendOpenAiUserRoleAssignmentId": {
      "type": "string",
      "value": "[if(variables('hasBackendPrincipal'), extensionResourceId(resourceId('Microsoft.CognitiveServices/accounts', variables('aiServicesName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.CognitiveServices/accounts', variables('aiServicesName')), parameters('backendPrincipalId'), variables('cognitiveServicesOpenAiUserRoleDefinitionId'))), '')]"
    },
    "backendSpeechUserRoleAssignmentId": {
      "type": "string",
      "value": "[if(variables('hasBackendPrincipal'), extensionResourceId(resourceId('Microsoft.CognitiveServices/accounts', variables('speechServiceName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.CognitiveServices/accounts', variables('speechServiceName')), parameters('backendPrincipalId'), variables('cognitiveServicesSpeechUserRoleDefinitionId'))), '')]"
    },
    "backendSearchServiceContributorRoleAssignmentId": {
      "type": "string",
      "value": "[if(variables('hasBackendPrincipal'), extensionResourceId(resourceId('Microsoft.Search/searchServices', variables('searchServiceName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.Search/searchServices', variables('searchServiceName')), parameters('backendPrincipalId'), variables('searchServiceContributorRoleDefinitionId'))), '')]"
    },
    "backendSearchIndexDataContributorRoleAssignmentId": {
      "type": "string",
      "value": "[if(variables('hasBackendPrincipal'), extensionResourceId(resourceId('Microsoft.Search/searchServices', variables('searchServiceName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.Search/searchServices', variables('searchServiceName')), parameters('backendPrincipalId'), variables('searchIndexDataContributorRoleDefinitionId'))), '')]"
    }
  }
}